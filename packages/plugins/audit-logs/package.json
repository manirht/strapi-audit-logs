{
  "name": "@strapi/plugin-audit-logs",
  "version": "1.0.0",
  "description": "Automated audit logging for all content changes in Strapi",
  "license": "MIT",
  "author": {
    "name": "Strapi Solutions SAS",
    "email": "hi@strapi.io",
    "url": "https://strapi.io"
  },
  "exports": {
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "strapi-server.js"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:code && npm run build:types",
    "build:code": "rollup -c",
    "build:types": "tsc -p server/tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf ./dist"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@strapi/strapi": "^5.0.0",
    "@strapi/types": "^5.0.0",
    "@types/lodash": "^4.14.202",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0 || ^5.0.0-beta || ^5.0.0-alpha || ^5.0.0-rc"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "name": "audit-logs",
    "displayName": "Audit Logs",
    "description": "Automated audit logging for all content changes",
    "kind": "plugin"
  }
}
